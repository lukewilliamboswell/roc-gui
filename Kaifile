on linux {
  environment development {
    packages: [
      "rustup",
      "zig_0_16",
      "python3",
      "git",
      "pkg-config",
      "rocpkgs.nightly-2026-09-12-220fd47",
      "bubblewrap",
      "alsa-lib",
      "freetype",
      "libxkbcommon",
      "libxcb",
      "wayland",
      "libdrm",
      "mesa",
      "vulkan-loader",
      "dbus",
      "udev",
      "libusb1",
      "fontconfig"
    ]
    overlays: [
      "github:roc-lang/roc-overlay/7338b792527a5025fdcccc431c0bb6aacdd5e240"
    ]
  }
}

on macos {
  environment development {
    packages: [
      "rustup",
      "zig_0_16",
      "python3",
      "git",
      "pkg-config",
      "rocpkgs.nightly-2026-09-12-220fd47"
    ]
    overlays: [
      "github:roc-lang/roc-overlay/7338b792527a5025fdcccc431c0bb6aacdd5e240"
    ]
  }
}

