(test "a query that matches no rows is an ordinary empty result"
  (grants
    (directory "fixture"))
  (steps
    (click (role button :name "Choose database folder"))
    (await-task)
    (click (role button :name "Open database bookstore.db"))
    (await-task)
    (replace-text (role textarea :name "SQL query") "SELECT id, title FROM books WHERE id < 0")
    (click (role button :name "Run query"))
    (await-task)
    (expect-not-visible (role panel :name "Database error"))
    (expect-visible (text "Columns: id, title"))
    (expect-visible (text "Rows: 0"))
    (expect-count (text-prefix "Result row ") 0)
    (replace-text (role textarea :name "SQL query") "SELECT id, title FROM books ORDER BY id LIMIT 1")
    (click (role button :name "Run query"))
    (await-task)
    (expect-visible (text "Rows: 1"))
    (expect-count (text-prefix "Result row ") 1)
    (expect-sqlite-counters 1 1 3)))
