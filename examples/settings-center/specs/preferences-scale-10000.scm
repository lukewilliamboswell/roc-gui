(test "save a realistic 10000-byte profile note"
  (benchmark :warmups 1 :samples 3 :iterations 1 :scale 10000 :initial-size 0 :change-size 10000)
  (steps
    (replace-text (role textarea :name "Profile notes") "")
    (mark-metrics)
    (click (role button :name "Apply profile") )
    (await-task)
    (expect-value-bytes (role textarea :name "Profile notes") 10000)))
