(test "Native stationary clicks visit only the affected row at each grid size"
  (steps
    (click (role button :name "Create 100 cells"))
    (settle)
    (expect-count (button-prefix "Cell ") 100)
    (mark-native-work)
    (click (role button :name "Cell 50"))
    (expect-background (role button :name "Cell 50") 0xF59E0B)
    (expect-native-work :button-renders-max 4 :boundary-renders-max 1 :boundary-elements-max 10)
    (mark-native-work)
    (click (role button :name "Cell 50"))
    (expect-background (role button :name "Cell 50") 0x263247)
    (expect-native-work :button-renders-max 4 :boundary-renders-max 1 :boundary-elements-max 10)
    (click (role button :name "Create 1000 cells"))
    (settle)
    (expect-count (button-prefix "Cell ") 1000)
    (mark-native-work)
    (click (role button :name "Cell 500"))
    (expect-background (role button :name "Cell 500") 0xF59E0B)
    (expect-native-work :button-renders-max 4 :boundary-renders-max 1 :boundary-elements-max 100)
    (click (role button :name "Create 10000 cells"))
    (settle)
    (expect-count (button-prefix "Cell ") 10000)
    (mark-native-work)
    (click (role button :name "Cell 5000"))
    (expect-background (role button :name "Cell 5000") 0xF59E0B)
    (expect-native-work :button-renders-max 4 :boundary-renders-max 1 :boundary-elements-max 100
      :cached-prepaint-subtrees-min 1 :cached-paint-subtrees-min 1
      :replayed-scene-operations-min 1 :fresh-hitboxes-max 16
      :fresh-mouse-listeners-max 32 :element-states-moved-min 1)))
