(test "Native container reuse visits only the affected row at each grid size"
  (steps
    (click (role button :name "Create 100 cells"))
    (settle)
    (expect-count (button-prefix "Cell ") 100)
    (mark-native-work)
    (hover-enter (role button :name "Cell 1"))
    (expect-background (role button :name "Cell 1") 0x66E0FF)
    (expect-native-work :button-renders-max 5 :boundary-renders-max 1 :boundary-elements-max 10)
    (hover-exit (role button :name "Cell 1"))
    (await-task)
    (settle)
    (expect-background (role button :name "Cell 1") 0x263247)
    (click (role button :name "Create 1000 cells"))
    (settle)
    (expect-count (button-prefix "Cell ") 1000)
    (mark-native-work)
    (hover-enter (role button :name "Cell 1"))
    (expect-background (role button :name "Cell 1") 0x66E0FF)
    (expect-native-work :button-renders-max 5 :boundary-renders-max 1 :boundary-elements-max 100)
    (hover-exit (role button :name "Cell 1"))
    (await-task)
    (settle)
    (expect-background (role button :name "Cell 1") 0x263247)
    (click (role button :name "Create 10000 cells"))
    (settle)
    (expect-count (button-prefix "Cell ") 10000)
    (mark-native-work)
    (hover-enter (role button :name "Cell 1"))
    (expect-background (role button :name "Cell 1") 0x66E0FF)
    (expect-native-work :button-renders-max 5 :boundary-renders-max 1 :boundary-elements-max 100)
    (hover-exit (role button :name "Cell 1"))
    (await-task)
    (settle)
    (expect-background (role button :name "Cell 1") 0x263247)))
