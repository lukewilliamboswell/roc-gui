(test "Editor actions use latest text under both memo policies"
  (steps
    (click (role button :name "Load 1000 bytes"))
    (click (role button :name "Refresh editor"))
    (expect-component-work :rendered 1 :compared 1 :skipped 1 :mounted 0 :retired 0)
    (click (role button :name "Append byte"))
    (click (role button :name "Append byte"))
    (expect-value-bytes (role textarea :name "Large request body") 1002)
    (expect-patch :kind replace :staged 4 :removed 4)
    (expect-component-work :rendered 1 :compared 1 :skipped 0 :mounted 0 :retired 0)
    (click (role button :name "Use unmemoized editor"))
    (expect-component-work :rendered 2 :compared 0 :skipped 0 :mounted 1 :retired 1)
    (expect-value-bytes (role textarea :name "Large request body") 1002)
    (click (role button :name "Refresh editor"))
    (expect-component-work :rendered 2 :compared 0 :skipped 0 :mounted 0 :retired 0)
    (click (role button :name "Append byte"))
    (click (role button :name "Append byte"))
    (expect-value-bytes (role textarea :name "Large request body") 1004)
    (expect-patch :kind replace :staged 4 :removed 4)
    (expect-component-work :rendered 1 :compared 0 :skipped 0 :mounted 0 :retired 0)))
