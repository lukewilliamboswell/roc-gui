(test "Row components keep their live handlers through parent changes and reordering"
  (steps
    (click (role button :name "Create 100 rows"))
    (click (role button :name "Select row 50"))
    (expect-visible (text "Selection: 50"))
    (expect-component-work :rendered 1 :compared 100 :skipped 100 :mounted 0 :retired 0)
    (click (role button :name "Increment row 50"))
    (expect-visible (text "Row 50: 1"))
    (expect-component-work :rendered 1 :compared 1 :registry-visits 1)
    (click (role button :name "Swap rows 2 and 99"))
    (expect-before (text "Row 99: 0") (text "Row 2: 0"))
    (expect-component-work :rendered 1 :compared 100 :skipped 100 :mounted 0 :retired 0)
    (click (role button :name "Increment row 2"))
    (expect-visible (text "Row 2: 1"))
    (expect-visible (text "Row 50: 1"))
    (expect-component-work :rendered 1 :compared 1 :registry-visits 1)
    (click (role button :name "Delete row 99"))
    (expect-count (text-prefix "Row ") 99)
    (expect-not-visible (text "Row 99: 0"))
    (expect-component-work :rendered 1 :compared 99 :skipped 99 :mounted 0 :retired 1)
    (click (role button :name "Increment row 2"))
    (expect-visible (text "Row 2: 2"))
    (expect-component-work :rendered 1 :compared 1 :registry-visits 1)
    (click (role button :name "Create 100 rows"))
    (expect-count (text-prefix "Row ") 100)
    (expect-visible (text "Row 2: 0"))
    (expect-visible (text "Row 99: 0"))
    (expect-component-work :mounted 1 :retired 0)
    (click (role button :name "Increment row 99"))
    (expect-visible (text "Row 99: 1"))
    (expect-component-work :rendered 1 :compared 1 :registry-visits 1)))
