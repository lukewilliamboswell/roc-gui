(test "Rows: repeated alternating selection within 100"
  (benchmark :warmups 2 :samples 7 :iterations 1 :scale 100 :initial-size 100 :change-size 20)
  (steps
    (click (role button :name "Create 100 rows")) (mark-metrics)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 625 :removed 625)
    (click (role button :name "Select row 100")) (expect-patch :kind replace :staged 625 :removed 625)
    (expect-count (text-prefix "Row ") 100) (expect-visible (text "Selection: 100"))))
