(test "Rows: repeated alternating selection within 10,000"
  (benchmark :warmups 2 :samples 7 :iterations 1 :scale 10000 :initial-size 10000 :change-size 20)
  (steps
    (click (role button :name "Create 10,000 rows")) (mark-metrics)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 1")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (click (role button :name "Select row 10000")) (expect-patch :kind replace :staged 60023 :removed 60023)
    (expect-count (text-prefix "Row ") 10000) (expect-visible (text "Selection: 10000"))))
